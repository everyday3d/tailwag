{
  "name": "tailwag",
  "version": "1.3.0",
  "description": "🐕 TailWag — 3D Filament Painting & TD Lithophane Studio",
  "main": "dist-electron/main.js",
  "author": "BoxerDawg 3D (everyday3d)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/build-electron.mjs",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 5188\" \"wait-on tcp:5188 && electron .\"",
    "fetch-model": "node scripts/fetch-model.mjs",
    "electron:pack": "npm run fetch-model && npm run build && electron-builder --dir",
    "electron:dist": "npm run fetch-model && npm run build && electron-builder",
    "electron:mac": "npm run fetch-model && npm run build && electron-builder --mac",
    "electron:win": "npm run fetch-model && npm run build && electron-builder --win",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "onnxruntime-node": "^1.30.0",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.boxerdawg3d.tailwag",
    "productName": "TailWag Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "*.onnx"
        ]
      }
    ],
    "mac": {
      "files": [
        "dist/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design",
      "artifactName": "TailWag-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "TailWag-Setup-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "files": [
        "dist/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
      ],
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "TailWag-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "TailWag-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "TailWag-Portable-${version}.${ext}"
    }
  }
}
